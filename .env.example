# 이 파일을 .env로 복사한 뒤 값을 채우세요. 실제 비밀값은 .env에만 적습니다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=wms_db
DB_USER=wms_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# 슬랙 또는 디스코드 웹훅 주소. 비워 두면 알림을 보내지 않습니다.
ALERT_WEBHOOK_URL=

# 택배사 API (가상 택배사: myenv\Scripts\python mock_carrier\server.py). 주소를 비워 두면 택배 연동을 쓰지 않습니다.
CARRIER_API_URL=http://127.0.0.1:8100
CARRIER_API_KEY=mock-carrier-key
CARRIER_WEBHOOK_SECRET=mock-webhook-secret
# 택배사가 배송 상태를 알려줄 WMS 주소
CARRIER_CALLBACK_URL=http://127.0.0.1:8000/api/carrier/webhook/
# 가상 택배사의 단계 진행 간격(초)과 일시 장애 확률(0~1)
MOCK_CARRIER_STEP_SECONDS=60
MOCK_CARRIER_FAIL_RATE=0

# 출고 마감 시각(이 시각 전 주문은 당일 출고)과 주말 출고 여부(1이면 주말도 출고일)
SHIP_CUTOFF_TIME=15:00
SHIP_ON_WEEKENDS=0

# 순환 재고 조사: 하루 조사할 위치 수, 모든 위치를 한 번씩 조사하는 목표 주기(일)
CYCLE_COUNT_DAILY=5
CYCLE_COUNT_DAYS=30

# 오류 감시: 같은 오류 알림 간격(분), 택배사 연속 실패 알림 기준(번)
ALERT_REPEAT_MINUTES=10
CARRIER_FAIL_ALERT=3
