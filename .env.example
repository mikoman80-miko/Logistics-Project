# 이 파일을 .env로 복사한 뒤 값을 채우세요. 실제 비밀값은 .env에만 적습니다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=wms_db
DB_USER=wms_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# 슬랙 또는 디스코드 웹훅 주소. 비워 두면 알림을 보내지 않습니다.
ALERT_WEBHOOK_URL=
